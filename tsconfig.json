{
  // api/, server/, scripts/ y tests corren en Node (Vercel) como ESM. Vercel compila las funciones con este archivo;
  // el front usa tsconfig.app.json. Como son ESM: los imports relativos
  // llevan extensión .js aunque el archivo sea .ts (import { x } from '../server/http.js').
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    // Solo para la CLI de shadcn/ui (lee el alias de acá); el front lo usa desde tsconfig.app.json.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["api", "server", "shared", "scripts/**/*.ts", "test", "vite.config.ts"]
}
